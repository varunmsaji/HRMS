<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31): nothing leaves the device by cloud backup or device-to-device transfer.
     The app support directory holds the persisted refresh-token cookie (a 30-day session
     credential), so a restored backup must never carry it. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>

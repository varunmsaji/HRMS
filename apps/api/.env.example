# Copy to .env for local development. Validated at boot by pydantic-settings (fail fast).
# See files/10_Authentication_Architecture.md and files/13_DevOps_Architecture.md.

ENVIRONMENT=development
PORT=8000
LOG_LEVEL=INFO

# Local per-module log files (docs/operations/LOGGING_GUIDE.md). A relative LOG_DIR is resolved
# against apps/api (/app in the container), not the working directory.
LOG_TO_FILES=true
LOG_DIR=logs
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5
LOG_RETENTION_DAYS=0
LOG_FILES_REQUIRED=false

# PostgreSQL 16 — host port 5433 (docker-compose.yml). `hrms_app` is a dedicated, non-superuser,
# non-BYPASSRLS runtime role — see docs/architecture/POSTGRES_RLS_ROLE_MIGRATION_PLAN.md.
DATABASE_URL=postgresql://hrms_app:hrms_app_dev_password@localhost:5433/hrms_dev

# Migrations run DDL and must run as the schema owner (`hrms`), never as DATABASE_URL's role.
MIGRATIONS_DATABASE_URL=postgresql://hrms:hrms_dev_password@localhost:5433/hrms_dev

# Redis 7 — host port 6380
REDIS_URL=redis://localhost:6380/0

JWT_ACCESS_SECRET=change-me-local-dev-only-min-16
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_SECRET=change-me-local-dev-too-min-16
JWT_REFRESH_TTL_DAYS=30

# OPS-01 (Production Hardening Batch 1) — empty/unset is fine in development only; the web
# app's dev origin is used automatically as a fallback. Comma-separated for more than one.
CORS_ALLOWED_ORIGINS=

# Frontend origin embedded in email links. The development default matches `next dev`.
# Staging and production refuse to boot on this value (FINDING-001); set WEB_APP_BASE_URL
# in those env files to https:// plus that tier's public web host.
WEB_APP_BASE_URL=http://localhost:3000

# OPS-02 — empty/unset in local dev (no reverse proxy in front of `uvicorn --reload`), so
# `X-Forwarded-For` is never trusted here either. Comma-separated host/CIDR list otherwise.
TRUSTED_PROXY_HOSTS=

APP_TIMEZONE_DEFAULT=Asia/Kolkata

# Self-hosted MinIO (docker-compose.yml `minio` service), not AWS S3 — this app runs on a
# Hostinger VPS (Upload Security Batch A, docs/audits/UPLOAD_BATCH_A_STORAGE_ARCHITECTURE.md).
# S3_ENDPOINT_URL is REQUIRED outside development: `Settings._guard_non_development_config`
# refuses to boot without it, since an unset endpoint would otherwise resolve to real AWS S3.
AWS_REGION=ap-south-1
S3_BUCKET_DOCUMENTS=hrms-documents
S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=hrms_minio
AWS_SECRET_ACCESS_KEY=hrms_minio_dev_password
# Only needed when the browser-facing hostname differs from S3_ENDPOINT_URL above — never true in
# local dev, where both the API and your browser reach MinIO at localhost:9000. See
# `Settings.s3_public_endpoint_url` / `DocumentStorageService.presigned_get_url`.
# S3_PUBLIC_ENDPOINT_URL=

# RELEASE_HARDENING_PHASE_5A (docs/audits/RELEASE_HARDENING_PHASE_5A_EMAIL.md) — "logging" (the
# default) writes the email to a structured log line instead of sending it, which is what local
# dev wants (the onboarding invite URL etc. is readable straight from the log/API response).
# staging/production refuse to boot with "logging" still selected — see the four env/.env.*
# files' own EMAIL_PROVIDER=smtp block for the required SMTP_* variables. EMAIL_PROVIDER=mailtrap
# is a second real option (Mailtrap's HTTP Send API instead of SMTP) — set MAILTRAP_API_TOKEN and
# SMTP_FROM_EMAIL/SMTP_FROM_NAME below instead of the SMTP_HOST/PORT/USERNAME/PASSWORD block.
EMAIL_PROVIDER=logging
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
# SMTP_FROM_NAME=Staff Spectrum HRMS
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
# MAILTRAP_API_TOKEN=
# EMAIL_PROVIDER=hostinger sends via the Hostinger Mail API: set HOSTINGER_MAIL_API_TOKEN and
# HOSTINGER_MAIL_MAILBOX_ID (the sending mailbox's resourceId from GET /api/v1/me);
# SMTP_FROM_NAME is used as the display name.
# HOSTINGER_MAIL_API_TOKEN=__SET_IN_REAL_FILE__
# HOSTINGER_MAIL_MAILBOX_ID=__SET_IN_REAL_FILE__

# Face attendance — "disabled" (default) rejects face enrollment/punches as unavailable. Set
# "facepp" plus FACEPP_API_KEY and FACEPP_API_SECRET to enable. Thresholds are 0..1 and applied
# on top of Face++'s own verdict.
FACE_VERIFICATION_PROVIDER=disabled
# FACEPP_API_KEY=
# FACEPP_API_SECRET=
# FACE_MATCH_MIN_SIMILARITY=0.90
# Server-side face liveness (anti-spoofing). Face punching and self-enrollment also need this:
# "disabled" (default) makes them unavailable — there is no fallback. "minifasnet" needs the
# `liveness` extra (`uv sync --extra liveness`) and the verified model assets; see
# docs/audits/FACE_ATTENDANCE_LIVENESS_IMPLEMENTATION_REPORT.md. Thresholds are UNCALIBRATED
# defaults — do not enable for production attendance before device/attack calibration.
FACE_LIVENESS_ENGINE=disabled
# FACE_LIVENESS_MODEL_DIR=models/liveness/minifasnet-v1
# (In the Docker image the assets are at /app/models/liveness/minifasnet-v1; with the engine
# enabled the API refuses to boot if any asset is missing or fails its pinned SHA-256. See
# docs/operations/FACE_LIVENESS_DOCKER_DEPLOYMENT.md.)
# FACE_LIVENESS_LIVE_THRESHOLD=0.90
# FACE_LIVENESS_SPOOF_THRESHOLD=0.50
# FACE_LIVENESS_FRAMES=3
# FACE_LIVENESS_SESSION_TTL_SECONDS=120
# Rejected self-enrollment submissions allowed per HR-opened window (then 429).
# FACE_ENROLLMENT_MAX_FAILED_ATTEMPTS=5
# Face provider transport: one pooled client per process. OUR bounds, not Face++ quotas (the
# account's real QPS / concurrency / FaceSet limits must be confirmed with the vendor).
# FACE_PROVIDER_CONNECT_TIMEOUT_SECONDS=5
# FACE_PROVIDER_MAX_CONCURRENCY=4
# One self-enrollment = ~18 sequential provider calls: total wall-clock budget, and the
# reservation lease that must exceed it (no DB lock/transaction is held while they run).
# FACE_ENROLLMENT_PROVIDER_BUDGET_SECONDS=120
# FACE_ENROLLMENT_LEASE_SECONDS=240
# Request-level flood ceilings per (tenant, client IP) per minute. Generous on purpose: an office
# can share one NAT address. Client IP honours TRUSTED_PROXY_HOSTS only.
# FACE_PUNCH_REQUESTS_PER_MINUTE_PER_IP=600
# FACE_ENROLLMENT_REQUESTS_PER_MINUTE_PER_IP=60
# FACE_REVIEW_PHOTO_REQUESTS_PER_MINUTE_PER_IP=120
# Post-commit external-deletion worker (Face++ FaceSets, review photos).
# FACE_DELETION_BATCH_SIZE=50
# FACE_DELETION_ALERT_AFTER_ATTEMPTS=5
# Biometric-record retention. NO period is defaulted: it needs a privacy/legal decision
# (docs/audits/FACE_ATTENDANCE_SECURITY_HARDENING_REPORT.md §12). Unset = keep everything. Even
# when set, the scheduled cleanup only reports until FACE_CLEANUP_DRY_RUN=false.
# FACE_LIVENESS_SESSION_RETENTION_DAYS=
# FACE_ATTEMPT_DETAIL_RETENTION_DAYS=
# FACE_ENROLLMENT_ATTEMPT_RETENTION_DAYS=
# FACE_CLEANUP_DRY_RUN=true
# FACE_CLEANUP_BATCH_SIZE=500
# FACE_CLEANUP_MAX_BATCHES=20
# Comma-separated company UUIDs under legal/operational hold: never cleaned.
# FACE_CLEANUP_HOLD_COMPANY_IDS=

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# RELEASE_HARDENING_PHASE_3A (docs/audits/RELEASE_HARDENING_PHASE_3A_SECURITY_REMEDIATION.md §9)
# — empty/unset is fine in development only: DekCache uses DEV_ENCRYPTION_KEY below instead.
# staging/production refuse to boot without this set to a strong, unique secret (replaces the
# previous AWS KMS_CMK_ARN setting — this deployment no longer depends on AWS KMS).
PII_MASTER_KEY=
# Development-only local encryption key — never used outside environment=development.
DEV_ENCRYPTION_KEY=change-me-local-dev-encryption-key-min-16
ENCRYPTION_DEK_CACHE_TTL_SECONDS=3600

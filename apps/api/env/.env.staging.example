# Staging/UAT — self-hosted, Docker Compose + Nginx + Let's Encrypt, no AWS-managed services
# (RELEASE_HARDENING_PHASE_3B; supersedes this file's previous ECS/RDS/ElastiCache/Secrets
# Manager content — an earlier, since-abandoned AWS architecture). A production mirror on its own
# VPS (or the same VPS under a separate `docker compose -p hrms-staging` project — this phase's
# own deployment work targets the single production Hostinger VPS; a staging tier is this file's
# own reference template, not something this phase provisioned). Copy to
# `apps/api/env/.env.staging` (gitignored) and reference from that tier's own compose `env_file`.

ENVIRONMENT=staging
PORT=8000
LOG_LEVEL=INFO

# `postgres`/`redis`/`minio` are the compose service names on staging's own internal network —
# same shape as production's `.env.production.example`, different host/values.
DATABASE_URL=postgresql://hrms_app:__SET_IN_REAL_FILE__@postgres:5432/hrms_staging
MIGRATIONS_DATABASE_URL=postgresql://hrms:__SET_IN_REAL_FILE__@postgres:5432/hrms_staging

REDIS_URL=redis://redis:6379/0

# Generate with `openssl rand -base64 48`. Must be distinct from every other environment's value,
# including production's — never share a JWT/PII secret across environments.
JWT_ACCESS_SECRET=__SET_IN_REAL_FILE__
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_SECRET=__SET_IN_REAL_FILE__
JWT_REFRESH_TTL_DAYS=30

CORS_ALLOWED_ORIGINS=https://staging.hrms.example.com

# The staging Nginx container's own Docker-network subnet — not production's, not a public range.
TRUSTED_PROXY_HOSTS=172.16.0.0/12

APP_TIMEZONE_DEFAULT=Asia/Kolkata

AWS_REGION=ap-south-1
S3_BUCKET_DOCUMENTS=hrms-staging-documents
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=https://storage-staging.hrms.example.com
AWS_ACCESS_KEY_ID=__SET_IN_REAL_FILE__
AWS_SECRET_ACCESS_KEY=__SET_IN_REAL_FILE__

# RELEASE_HARDENING_PHASE_5A (docs/audits/RELEASE_HARDENING_PHASE_5A_EMAIL.md) — REQUIRED outside
# development: `Settings._guard_non_development_config` refuses to boot with EMAIL_PROVIDER=logging
# in staging/production (no real email would ever be delivered). Any standard authenticated SMTP
# endpoint works — a transactional-email vendor's SMTP relay, a self-hosted MTA, etc. Never AWS SES.
# Alternative: EMAIL_PROVIDER=mailtrap sends via Mailtrap's HTTP Send API instead of SMTP — set
# MAILTRAP_API_TOKEN plus SMTP_FROM_EMAIL/SMTP_FROM_NAME below and drop the SMTP_HOST/PORT/
# USERNAME/PASSWORD/USE_TLS/USE_SSL lines.
EMAIL_PROVIDER=smtp
SMTP_HOST=__SET_IN_REAL_FILE__
SMTP_PORT=587
SMTP_USERNAME=__SET_IN_REAL_FILE__
SMTP_PASSWORD=__SET_IN_REAL_FILE__
SMTP_FROM_EMAIL=__SET_IN_REAL_FILE__
SMTP_FROM_NAME=Staff Spectrum HRMS
# Exactly one of these two must be true — STARTTLS (587) or implicit TLS (465), never plaintext.
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# MAILTRAP_API_TOKEN=__SET_IN_REAL_FILE__

# Face attendance — "disabled" (default) rejects face enrollment/punches as unavailable. Set
# "facepp" plus FACEPP_API_KEY and FACEPP_API_SECRET to enable. Thresholds are 0..1 and applied
# on top of Face++'s own verdict.
FACE_VERIFICATION_PROVIDER=disabled
# FACEPP_API_KEY=__SET_IN_REAL_FILE__
# FACEPP_API_SECRET=__SET_IN_REAL_FILE__
# FACE_MATCH_MIN_SIMILARITY=0.90

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# RELEASE_HARDENING_PHASE_3A §9 — own distinct value; never shared with any other environment.
PII_MASTER_KEY=__SET_IN_REAL_FILE__
ENCRYPTION_DEK_CACHE_TTL_SECONDS=3600

# Staging/UAT environment (Doc 14 §2): production mirror, anonymised client data, manual promotion
# from QA. This is where pilot customers and the client sign off before go-live (Doc 12 §3, UAT).
# Real values come from SSM Parameter Store + Secrets Manager — reference template only.

NODE_ENV=production
PORT=3000

# Multi-AZ RDS, production-shaped (Doc 14 §1.1). `hrms_app`: dedicated, non-superuser,
# non-BYPASSRLS runtime role (docs/architecture/POSTGRES_RLS_ROLE_MIGRATION_PLAN.md).
DATABASE_URL="postgresql://hrms_app:__FROM_SECRETS_MANAGER__@hrms-staging.cluster-xxxxx.ap-south-1.rds.amazonaws.com:5432/hrms_staging?schema=public&sslmode=require"

# Migration/DDL role (RDS master user or equivalent schema owner) — deploy pipeline only.
MIGRATIONS_DATABASE_URL="postgresql://hrms:__FROM_SECRETS_MANAGER__@hrms-staging.cluster-xxxxx.ap-south-1.rds.amazonaws.com:5432/hrms_staging?schema=public&sslmode=require"

REDIS_URL="redis://hrms-staging.xxxxx.ng.0001.aps1.cache.amazonaws.com:6379"

JWT_ACCESS_SECRET="__FROM_SECRETS_MANAGER__"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="__FROM_SECRETS_MANAGER__"
JWT_REFRESH_TTL="30d"

APP_TIMEZONE_DEFAULT="Asia/Kolkata"

AWS_REGION="ap-south-1"
S3_BUCKET_DOCUMENTS="hrms-staging-documents"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

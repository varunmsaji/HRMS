# Production (Doc 14 §2): full HA, real tenant data, manual-approval deploy after staging sign-off.
# Every secret below is injected by ECS task definition from AWS Secrets Manager at container
# startup (Doc 14 §1, §7) — production NEVER reads a .env file from disk. This template exists so
# the required variable set is documented in one place, matched against Secrets Manager entries
# during environment setup and audited during the annual DR drill (Doc 14 §7).

# `ENVIRONMENT` (not `NODE_ENV`) is what `hrms.core.config.settings.Settings` actually reads
# (Production Hardening Batch 1) — without this exact value the SEC-01/OPS-01 boot guard never
# engages and the API silently runs with development defaults. `NODE_ENV` is the web app's own
# variable and does not gate anything in the API.
ENVIRONMENT=production
NODE_ENV=production
PORT=3000

# Multi-AZ primary + 1 read replica (Doc 14 §1). Connection string itself is a Secrets Manager
# secret, not assembled from separate host/user/password parameters, so rotation is atomic.
# This secret MUST resolve to `hrms_app`, a dedicated non-superuser, non-BYPASSRLS runtime role —
# never the RDS master user (docs/architecture/POSTGRES_RLS_ROLE_MIGRATION_PLAN.md).
DATABASE_URL="__FROM_SECRETS_MANAGER__"

# Separate secret: the RDS master user (or an equivalent schema-owner role), used only by the
# deploy pipeline's `alembic upgrade head` step — never injected into the running application task.
MIGRATIONS_DATABASE_URL="__FROM_SECRETS_MANAGER__"

# ElastiCache Redis, cluster mode, 2+ nodes (Doc 14 §1).
REDIS_URL="__FROM_SECRETS_MANAGER__"

JWT_ACCESS_SECRET="__FROM_SECRETS_MANAGER__"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="__FROM_SECRETS_MANAGER__"
JWT_REFRESH_TTL="30d"

# OPS-01 (Production Hardening Batch 1) — required: the API refuses to boot without at least
# one explicit origin. Comma-separated if the production web app is reachable at more than one
# hostname (e.g. an apex domain plus `www`).
CORS_ALLOWED_ORIGINS="https://app.hrms.example.com"

# OPS-02 — the ALB's private-subnet CIDR in front of this ECS service. Only hosts/CIDRs listed
# here are ever trusted to set `X-Forwarded-For`; never set this to a public/untrusted range.
TRUSTED_PROXY_HOSTS="10.0.0.0/16"

APP_TIMEZONE_DEFAULT="Asia/Kolkata"

# Self-hosted MinIO on the Hostinger VPS, not AWS S3 (Upload Security Batch A,
# docs/audits/UPLOAD_BATCH_A_STORAGE_ARCHITECTURE.md) — REQUIRED: `_guard_non_development_config`
# refuses to boot without an explicit endpoint, since leaving it unset would otherwise resolve to
# real AWS S3 rather than this deployment's MinIO. The internal Docker-network address of the
# `minio` container — never the public internet.
AWS_REGION="ap-south-1"
S3_BUCKET_DOCUMENTS="hrms-prod-documents"
S3_ENDPOINT_URL="http://minio:9000"
# The Nginx-fronted, browser-reachable hostname presigned GET URLs are signed against and issued
# to (see `DocumentStorageService.presigned_get_url`) — MinIO's S3 API itself is never exposed
# publicly. Optional; falls back to S3_ENDPOINT_URL when unset.
S3_PUBLIC_ENDPOINT_URL="https://storage.hrms.example.com"
# Static MinIO credentials — a self-hosted VPS has no IAM instance-role fallback. Inject via the
# same secret store as the JWT/DB secrets above; never commit real values.
AWS_ACCESS_KEY_ID="__FROM_SECRETS_MANAGER__"
AWS_SECRET_ACCESS_KEY="__FROM_SECRETS_MANAGER__"

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# DATA-01 (docs/audits/DATA_01_PII_ENCRYPTION_IMPLEMENTATION_PLAN.md) — the KMS customer-managed
# key that wraps this environment's application DEK(s) (plan §2.1/§5.2). The API refuses to boot
# without this set to a real ARN/alias. IAM: the ECS task role gets only kms:GenerateDataKey and
# kms:Decrypt on this key's ARN — never kms:ScheduleKeyDeletion/kms:DisableKey/kms:PutKeyPolicy
# (plan §5.2/§13.6 — key administration is a separate, human/CI-only principal).
KMS_CMK_ARN="__FROM_SECRETS_MANAGER__"

# Production — self-hosted Hostinger VPS, Docker Compose + Nginx + Let's Encrypt, no AWS-managed
# services (RELEASE_HARDENING_PHASE_3B; supersedes this file's previous ECS/RDS/ElastiCache/
# Secrets Manager content, which described an earlier, since-abandoned AWS architecture — see
# docs/audits/RELEASE_HARDENING_PHASE_3A_SECURITY_REMEDIATION.md §9 for the KMS half of that same
# pivot). Copy to `apps/api/env/.env.production` (gitignored — never commit the real file) and
# reference it from docker-compose.prod.yml's `api`/`worker`/`beat`/`migrate` services' `env_file`.
# See docs/deployment/PRODUCTION_DEPLOYMENT.md for the full setup procedure.

ENVIRONMENT=production
PORT=8000
LOG_LEVEL=INFO

# `postgres`/`redis`/`minio` below are the docker-compose.prod.yml service names — resolved via
# Docker's internal DNS on the `data` network, not a public hostname. This connects as `hrms_app`,
# the restricted runtime role provisioned by infra/docker/postgres/init/002_app_role.sh — its
# password segment must match docker-compose.prod.yml's own `.env`'s `HRMS_APP_PASSWORD`, NOT
# `POSTGRES_PASSWORD` (that's a different role — see MIGRATIONS_DATABASE_URL below). The two files
# are not automatically kept in sync; see the runbook (RELEASE_HARDENING_PHASE_6A / Finding DB-01).
DATABASE_URL=postgresql://hrms_app:__SET_IN_REAL_FILE__@postgres:5432/hrms_prod
# Migrations run DDL and must run as the schema-owner role (`hrms`), never `hrms_app` — used only
# by the one-off `migrate` compose service (`docker compose -f docker-compose.prod.yml --profile
# tools run --rm migrate`), never by the running `api`/`worker`/`beat` containers. This password
# segment matches docker-compose.prod.yml's own `.env`'s `POSTGRES_PASSWORD`.
MIGRATIONS_DATABASE_URL=postgresql://hrms:__SET_IN_REAL_FILE__@postgres:5432/hrms_prod

REDIS_URL=redis://redis:6379/0

# Generate with `openssl rand -base64 48` — 32+ characters, 8+ distinct characters
# (`Settings._guard_non_development_config`'s entropy floor). Never reuse a value across
# environments; never reuse the repository-visible development default.
JWT_ACCESS_SECRET=__SET_IN_REAL_FILE__
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_SECRET=__SET_IN_REAL_FILE__
JWT_REFRESH_TTL_DAYS=30

# OPS-01 — required: the API refuses to boot without at least one explicit origin. Comma-separated
# if the production web app is reachable at more than one hostname (e.g. an apex domain plus
# `www`). Must match docker-compose.prod.yml's `.env`'s `WEB_DOMAIN`.
CORS_ALLOWED_ORIGINS=https://app.hrms.example.com

# FINDING-001 — public frontend origin embedded in verification, password-reset, invite,
# onboarding, and attendance emails. Must be https and the same host as this file's
# CORS_ALLOWED_ORIGINS and as docker-compose's WEB_DOMAIN (scheme added here; WEB_DOMAIN
# itself has none). The API refuses to boot outside development when this is missing,
# localhost, loopback, or not https. The field default is http://localhost:3000 and must
# never be what a recipient's mail client opens. Do not hard-code a real customer domain
# in source; set this per deployment.
WEB_APP_BASE_URL=https://app.hrms.example.com

# OPS-02 — the Nginx container's own Docker-network address/subnet (the `edge`/`data` network
# CIDR Compose assigns — check with `docker network inspect hrms-prod_data`), NOT a public range.
# Only hosts/CIDRs listed here are ever trusted to set `X-Forwarded-For`/`X-Forwarded-Proto` —
# this is what lets ProxyHeadersMiddleware trust Nginx's forwarded scheme, which in turn is what
# makes HSTS/secure-cookie behavior activate correctly behind TLS termination (see
# docs/deployment/PRODUCTION_DEPLOYMENT.md's HTTPS section).
TRUSTED_PROXY_HOSTS=172.16.0.0/12

APP_TIMEZONE_DEFAULT=Asia/Kolkata

# Self-hosted MinIO (docker-compose.prod.yml's `minio` service), not AWS S3 — this app runs on a
# Hostinger VPS (Upload Security Batch A, docs/audits/UPLOAD_BATCH_A_STORAGE_ARCHITECTURE.md).
# `minio:9000` is the internal Docker-network address; REQUIRED — `_guard_non_development_config`
# refuses to boot without it, since an unset endpoint resolves to real AWS S3 instead.
AWS_REGION=ap-south-1
S3_BUCKET_DOCUMENTS=hrms-prod-documents
S3_ENDPOINT_URL=http://minio:9000
# The Nginx-fronted, browser-reachable hostname presigned GET/PUT URLs are signed against and
# issued to (infra/nginx/conf.d/hrms.conf.template's `${STORAGE_DOMAIN}` server block) — MinIO's
# S3 API is never exposed to the public internet directly. Must match docker-compose.prod.yml's
# `.env`'s `STORAGE_DOMAIN`.
S3_PUBLIC_ENDPOINT_URL=https://storage.hrms.example.com
# Static MinIO credentials — a self-hosted VPS has no IAM instance-role fallback. Must match
# docker-compose.prod.yml's `.env`'s `MINIO_ROOT_USER`/`MINIO_ROOT_PASSWORD`.
AWS_ACCESS_KEY_ID=__SET_IN_REAL_FILE__
AWS_SECRET_ACCESS_KEY=__SET_IN_REAL_FILE__

# RELEASE_HARDENING_PHASE_5A (docs/audits/RELEASE_HARDENING_PHASE_5A_EMAIL.md) — REQUIRED: refuses
# to boot with EMAIL_PROVIDER=logging outside development (no real email would ever be delivered —
# verification/invite/password-reset would all be silently unreachable). Any standard authenticated
# SMTP endpoint works — a transactional-email vendor's SMTP relay, a self-hosted MTA, etc. Never
# AWS SES: this deployment's architecture avoids AWS-managed services everywhere, email included.
# Alternative: EMAIL_PROVIDER=mailtrap sends via Mailtrap's HTTP Send API instead of SMTP — set
# MAILTRAP_API_TOKEN plus SMTP_FROM_EMAIL/SMTP_FROM_NAME below and drop the SMTP_HOST/PORT/
# USERNAME/PASSWORD/USE_TLS/USE_SSL lines.
EMAIL_PROVIDER=smtp
SMTP_HOST=__SET_IN_REAL_FILE__
SMTP_PORT=587
SMTP_USERNAME=__SET_IN_REAL_FILE__
SMTP_PASSWORD=__SET_IN_REAL_FILE__
SMTP_FROM_EMAIL=__SET_IN_REAL_FILE__
SMTP_FROM_NAME=Staff Spectrum HRMS
# Exactly one of these two must be true — STARTTLS (587) or implicit TLS (465), never plaintext.
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# MAILTRAP_API_TOKEN=__SET_IN_REAL_FILE__
# EMAIL_PROVIDER=hostinger sends via the Hostinger Mail API: set HOSTINGER_MAIL_API_TOKEN and
# HOSTINGER_MAIL_MAILBOX_ID (the sending mailbox's resourceId from GET /api/v1/me);
# SMTP_FROM_NAME is used as the display name.
# HOSTINGER_MAIL_API_TOKEN=__SET_IN_REAL_FILE__
# HOSTINGER_MAIL_MAILBOX_ID=__SET_IN_REAL_FILE__

# Face attendance — "disabled" (default) rejects face enrollment/punches as unavailable. Set
# "facepp" plus FACEPP_API_KEY and FACEPP_API_SECRET to enable. Thresholds are 0..1 and applied
# on top of Face++'s own verdict.
FACE_VERIFICATION_PROVIDER=disabled
# FACEPP_API_KEY=__SET_IN_REAL_FILE__
# FACEPP_API_SECRET=__SET_IN_REAL_FILE__
# FACE_MATCH_MIN_SIMILARITY=0.90

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# RELEASE_HARDENING_PHASE_3A §9 — the application master key that wraps this environment's DEK(s)
# (core/crypto/master_key.py). Generate with `openssl rand -base64 48`; store it the same way
# JWT_ACCESS_SECRET/JWT_REFRESH_SECRET are stored, never in source control or the database, and
# never rotate it without a real DEK-rotation step (`hrms.core.crypto.provisioning.rotate_key`)
# first — losing this value makes every existing PII field permanently undecryptable. See
# docs/deployment/DISASTER_RECOVERY.md for how this key must be preserved outside the VPS itself.
PII_MASTER_KEY=__SET_IN_REAL_FILE__
ENCRYPTION_DEK_CACHE_TTL_SECONDS=3600

# Dev (deployed, shared) — self-hosted, Docker Compose, no AWS-managed services
# (RELEASE_HARDENING_PHASE_3B; supersedes this file's previous ECS/RDS/ElastiCache/Secrets
# Manager content — an earlier, since-abandoned AWS architecture). Distinct from a developer's own
# local machine (`apps/api/.env.example`, used by `scripts/dev.py`) — this is a shared, deployed
# "dev" tier for integration testing before QA, on its own VPS or the same VPS under a separate
# `docker compose -p hrms-dev` project. Copy to `apps/api/env/.env.dev` (gitignored) and reference
# from that tier's own compose `env_file`.

ENVIRONMENT=development
PORT=8000
LOG_LEVEL=INFO

DATABASE_URL=postgresql://hrms_app:__SET_IN_REAL_FILE__@postgres:5432/hrms_dev_shared
MIGRATIONS_DATABASE_URL=postgresql://hrms:__SET_IN_REAL_FILE__@postgres:5432/hrms_dev_shared

REDIS_URL=redis://redis:6379/0

JWT_ACCESS_SECRET=__SET_IN_REAL_FILE__
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_SECRET=__SET_IN_REAL_FILE__
JWT_REFRESH_TTL_DAYS=30

# `environment=development` does not enforce the SEC-01/OPS-01 boot guard (`Settings.
# is_development` short-circuits `_guard_non_development_config`) — CORS/TRUSTED_PROXY_HOSTS
# below are still worth setting explicitly for a real deployed tier reachable over the network,
# even though a missing value would only fall back to the dev default here, not fail boot.
CORS_ALLOWED_ORIGINS=https://dev.hrms.example.com
TRUSTED_PROXY_HOSTS=172.16.0.0/12

APP_TIMEZONE_DEFAULT=Asia/Kolkata

AWS_REGION=ap-south-1
S3_BUCKET_DOCUMENTS=hrms-dev-documents
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=https://storage-dev.hrms.example.com
AWS_ACCESS_KEY_ID=__SET_IN_REAL_FILE__
AWS_SECRET_ACCESS_KEY=__SET_IN_REAL_FILE__

# RELEASE_HARDENING_PHASE_5A (docs/audits/RELEASE_HARDENING_PHASE_5A_EMAIL.md) — `environment=
# development` does not enforce the EMAIL_PROVIDER=smtp boot guard here either (same
# `is_development` short-circuit noted above for CORS/PII_MASTER_KEY), but this is a real, shared,
# network-reachable tier, not a local machine — worth setting explicitly so its onboarding-invite/
# verification/password-reset emails actually deliver, same reasoning as this file's own
# PII_MASTER_KEY/CORS values below. Never AWS SES — any standard authenticated SMTP endpoint works.
# Alternative: EMAIL_PROVIDER=mailtrap sends via Mailtrap's HTTP Send API instead of SMTP — set
# MAILTRAP_API_TOKEN plus SMTP_FROM_EMAIL/SMTP_FROM_NAME below and drop the SMTP_HOST/PORT/
# USERNAME/PASSWORD/USE_TLS/USE_SSL lines.
EMAIL_PROVIDER=smtp
SMTP_HOST=__SET_IN_REAL_FILE__
SMTP_PORT=587
SMTP_USERNAME=__SET_IN_REAL_FILE__
SMTP_PASSWORD=__SET_IN_REAL_FILE__
SMTP_FROM_EMAIL=__SET_IN_REAL_FILE__
SMTP_FROM_NAME=Staff Spectrum HRMS
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# MAILTRAP_API_TOKEN=__SET_IN_REAL_FILE__

# Face attendance — "disabled" (default) rejects face enrollment/punches as unavailable. Set
# "luxand" plus LUXAND_API_TOKEN to enable. Thresholds are 0..1 and applied on top of Luxand's
# own verdict.
FACE_VERIFICATION_PROVIDER=disabled
# LUXAND_API_TOKEN=__SET_IN_REAL_FILE__
# FACE_MATCH_MIN_SIMILARITY=0.90
# FACE_LIVENESS_MIN_SCORE=0.80

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200

# Optional in `environment=development` (falls back to DEV_ENCRYPTION_KEY) — still worth setting
# explicitly for a real deployed tier so its PII ciphertext isn't wrapped under the
# repository-visible dev default.
PII_MASTER_KEY=__SET_IN_REAL_FILE__
DEV_ENCRYPTION_KEY=change-me-local-dev-encryption-key-min-16
ENCRYPTION_DEK_CACHE_TTL_SECONDS=3600

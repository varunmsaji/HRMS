# Dev environment (Doc 14 §2): single small ECS cluster, seeded synthetic data, auto-deployed on
# merge to `develop`. Real values are injected via GitHub Actions secrets / SSM Parameter Store —
# this file is a reference template only, never loaded directly.

NODE_ENV=development
PORT=3000

# RDS PostgreSQL 16, dev-sized instance (Doc 14 §1.1: db.r6g.large or smaller for this tier).
DATABASE_URL="postgresql://hrms_app:__FROM_SECRETS_MANAGER__@hrms-dev.cluster-xxxxx.ap-south-1.rds.amazonaws.com:5432/hrms_dev?schema=public&sslmode=require"

# ElastiCache Redis, single node acceptable for dev traffic.
REDIS_URL="redis://hrms-dev.xxxxx.ng.0001.aps1.cache.amazonaws.com:6379"

JWT_ACCESS_SECRET="__FROM_SECRETS_MANAGER__"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="__FROM_SECRETS_MANAGER__"
JWT_REFRESH_TTL="30d"

APP_TIMEZONE_DEFAULT="Asia/Kolkata"

AWS_REGION="ap-south-1"
S3_BUCKET_DOCUMENTS="hrms-dev-documents"
# AWS credentials: use the ECS task role in every deployed environment, never static keys.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200

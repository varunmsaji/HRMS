# QA environment (Doc 14 §2): production-shaped but smaller, anonymised realistic dataset, auto-
# deployed on merge to `develop` alongside Dev. Real values come from SSM Parameter Store — this
# file is a reference template only, never loaded directly.

# `ENVIRONMENT` (not `NODE_ENV`) is what `hrms.core.config.settings.Settings` actually reads
# (Production Hardening Batch 1); `Settings.environment` only models `development`/`staging`/
# `production`, and this production-shaped tier maps to `staging` so the SEC-01/OPS-01 boot
# guard (real secrets, explicit CORS origins) applies here too.
ENVIRONMENT=staging
NODE_ENV=test
PORT=3000

# `hrms_app`: dedicated, non-superuser, non-BYPASSRLS runtime role
# (docs/architecture/POSTGRES_RLS_ROLE_MIGRATION_PLAN.md).
DATABASE_URL="postgresql://hrms_app:__FROM_SECRETS_MANAGER__@hrms-qa.cluster-xxxxx.ap-south-1.rds.amazonaws.com:5432/hrms_qa?schema=public&sslmode=require"

# Migration/DDL role (RDS master user or equivalent schema owner) — deploy pipeline only.
MIGRATIONS_DATABASE_URL="postgresql://hrms:__FROM_SECRETS_MANAGER__@hrms-qa.cluster-xxxxx.ap-south-1.rds.amazonaws.com:5432/hrms_qa?schema=public&sslmode=require"

REDIS_URL="redis://hrms-qa.xxxxx.ng.0001.aps1.cache.amazonaws.com:6379"

JWT_ACCESS_SECRET="__FROM_SECRETS_MANAGER__"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="__FROM_SECRETS_MANAGER__"
JWT_REFRESH_TTL="30d"

# OPS-01 (Production Hardening Batch 1) — required: boot fails without at least one explicit
# origin outside `development`.
CORS_ALLOWED_ORIGINS="https://qa.hrms.example.com"

# OPS-02 — the ALB's private-subnet CIDR in front of this ECS service.
TRUSTED_PROXY_HOSTS="10.0.0.0/16"

APP_TIMEZONE_DEFAULT="Asia/Kolkata"

# Self-hosted MinIO on the Hostinger VPS, not AWS S3 (Upload Security Batch A,
# docs/audits/UPLOAD_BATCH_A_STORAGE_ARCHITECTURE.md) — REQUIRED: `_guard_non_development_config`
# refuses to boot without an explicit endpoint, since leaving it unset would otherwise resolve to
# real AWS S3 rather than this deployment's MinIO. The internal Docker-network address of the
# `minio` container — never the public internet.
AWS_REGION="ap-south-1"
S3_BUCKET_DOCUMENTS="hrms-qa-documents"
S3_ENDPOINT_URL="http://minio:9000"
# The Nginx-fronted, browser-reachable hostname presigned GET URLs are signed against and issued
# to (see `DocumentStorageService.presigned_get_url`) — MinIO's S3 API itself is never exposed
# publicly. Optional; falls back to S3_ENDPOINT_URL when unset.
S3_PUBLIC_ENDPOINT_URL="https://storage-qa.hrms.example.com"
# Static MinIO credentials — a self-hosted VPS has no IAM instance-role fallback. Inject via the
# same secret store as the JWT/DB secrets above; never commit real values.
AWS_ACCESS_KEY_ID="__FROM_SECRETS_MANAGER__"
AWS_SECRET_ACCESS_KEY="__FROM_SECRETS_MANAGER__"

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200

# DATA-01 (docs/audits/DATA_01_PII_ENCRYPTION_IMPLEMENTATION_PLAN.md) — the KMS customer-managed
# key that wraps this environment's application DEK(s) (plan §2.1/§5.2). The API refuses to boot
# without this set to a real ARN/alias outside development.
KMS_CMK_ARN="__FROM_SECRETS_MANAGER__"

# QA — self-hosted, Docker Compose + Nginx + Let's Encrypt, no AWS-managed services
# (RELEASE_HARDENING_PHASE_3B; supersedes this file's previous ECS/RDS/ElastiCache/Secrets
# Manager content — an earlier, since-abandoned AWS architecture). `Settings.environment` only
# models `development`/`staging`/`production` (`hrms/core/config/settings.py`), so this
# production-shaped tier maps to `staging` — same as `.env.staging.example` — so the
# SEC-01/OPS-01 boot guard (real secrets, explicit CORS origins) applies here too. Copy to
# `apps/api/env/.env.qa` (gitignored) and reference from that tier's own compose `env_file`.

ENVIRONMENT=staging
PORT=8000
LOG_LEVEL=INFO

DATABASE_URL=postgresql://hrms_app:__SET_IN_REAL_FILE__@postgres:5432/hrms_qa
MIGRATIONS_DATABASE_URL=postgresql://hrms:__SET_IN_REAL_FILE__@postgres:5432/hrms_qa

REDIS_URL=redis://redis:6379/0

# Generate with `openssl rand -base64 48`. Must be distinct from every other environment's value.
JWT_ACCESS_SECRET=__SET_IN_REAL_FILE__
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_SECRET=__SET_IN_REAL_FILE__
JWT_REFRESH_TTL_DAYS=30

CORS_ALLOWED_ORIGINS=https://qa.hrms.example.com

# The QA Nginx container's own Docker-network subnet — not production's, not a public range.
TRUSTED_PROXY_HOSTS=172.16.0.0/12

APP_TIMEZONE_DEFAULT=Asia/Kolkata

AWS_REGION=ap-south-1
S3_BUCKET_DOCUMENTS=hrms-qa-documents
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=https://storage-qa.hrms.example.com
AWS_ACCESS_KEY_ID=__SET_IN_REAL_FILE__
AWS_SECRET_ACCESS_KEY=__SET_IN_REAL_FILE__

# RELEASE_HARDENING_PHASE_5A (docs/audits/RELEASE_HARDENING_PHASE_5A_EMAIL.md) — REQUIRED outside
# development: `Settings._guard_non_development_config` refuses to boot with EMAIL_PROVIDER=logging
# in staging/production (no real email would ever be delivered). Any standard authenticated SMTP
# endpoint works — a transactional-email vendor's SMTP relay, a self-hosted MTA, etc. Never AWS SES.
EMAIL_PROVIDER=smtp
SMTP_HOST=__SET_IN_REAL_FILE__
SMTP_PORT=587
SMTP_USERNAME=__SET_IN_REAL_FILE__
SMTP_PASSWORD=__SET_IN_REAL_FILE__
SMTP_FROM_EMAIL=__SET_IN_REAL_FILE__
SMTP_FROM_NAME=Staff Spectrum HRMS
# Exactly one of these two must be true — STARTTLS (587) or implicit TLS (465), never plaintext.
SMTP_USE_TLS=true
SMTP_USE_SSL=false

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200

# RELEASE_HARDENING_PHASE_3A §9 — own distinct value; never shared with any other environment.
PII_MASTER_KEY=__SET_IN_REAL_FILE__
ENCRYPTION_DEK_CACHE_TTL_SECONDS=3600

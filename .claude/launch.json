{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd apps/api && ./.venv/bin/python -m uvicorn entrypoints.api:app --reload --port 8000"
      ],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd apps/web && npm run dev"
      ],
      "port": 3000
    },
    {
      "name": "web-ui-design",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd ../HRMS-ui_design/apps/web && npx next dev --port 3001 --webpack"
      ],
      "port": 3001
    }
  ]
}
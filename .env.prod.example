# Copy to `.env` at the repo root (gitignored) before running:
#   docker compose -f docker-compose.prod.yml --profile tools up -d
# Drives docker-compose.prod.yml's own variable substitution (Postgres/MinIO container
# credentials, Nginx domains, frontend build-time API URL) — NOT the application's own Settings,
# which come from apps/api/env/.env.production (copy from apps/api/env/.env.production.example)
# instead. See docs/deployment/PRODUCTION_DEPLOYMENT.md.

IMAGE_TAG=latest

# --- Domains (RELEASE_HARDENING_PHASE_3B §5) ---
# Must already resolve (A/AAAA record) to this VPS before the first `certbot certonly` run.
WEB_DOMAIN=app.hrms.example.com
API_DOMAIN=api.hrms.example.com
STORAGE_DOMAIN=storage.hrms.example.com
LETSENCRYPT_EMAIL=ops@hrms.example.com

# Baked into the frontend's client JS bundle at Docker build time (apps/web/Dockerfile) — changing
# this requires rebuilding and redeploying the `web` image, not just restarting the container.
NEXT_PUBLIC_API_URL=https://api.hrms.example.com

# --- Postgres (container-internal credentials) ---
# POSTGRES_PASSWORD is the schema-owner (`hrms`) role's password — must match the password segment
# of apps/api/env/.env.production's MIGRATIONS_DATABASE_URL.
# HRMS_APP_PASSWORD provisions the application's own runtime role (`hrms_app`,
# infra/docker/postgres/init/002_app_role.sh — RELEASE_HARDENING_PHASE_6A / Finding DB-01) — a
# DIFFERENT role and password from POSTGRES_PASSWORD above. Must match the password segment of
# apps/api/env/.env.production's DATABASE_URL. Neither of this file's values is kept in sync with
# that one automatically — see the runbook.
POSTGRES_USER=hrms
POSTGRES_PASSWORD=__CHANGE_ME_GENERATE_WITH_openssl_rand_-base64_32__
POSTGRES_DB=hrms_prod
HRMS_APP_PASSWORD=__CHANGE_ME_GENERATE_WITH_openssl_rand_-base64_32__

# --- MinIO (container-internal credentials) ---
# Must match apps/api/env/.env.production's AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY.
MINIO_ROOT_USER=hrms_minio
MINIO_ROOT_PASSWORD=__CHANGE_ME_GENERATE_WITH_openssl_rand_-base64_32__
MINIO_BUCKET_DOCUMENTS=hrms-prod-documents

# --- Celery worker concurrency (optional; defaults to 2 in docker-compose.prod.yml) ---
CELERY_CONCURRENCY=2

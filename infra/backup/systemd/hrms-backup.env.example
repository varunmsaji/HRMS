# /etc/hrms-backup/hrms-backup.env (root, 600). No secrets here: the Drive token lives in rclone's
# config (/root/.config/rclone/rclone.conf) and only the age PUBLIC key is on the server.
COMPOSE_PROJECT_DIR=/opt/hrms
COMPOSE_FILE=docker-compose.vps.yml
# Every HRMS database. The app currently runs on hrms_demo.
BACKUP_DATABASES="hrms_demo hrms_prod"
BACKUP_ROOT=/var/backups/hrms
AGE_RECIPIENTS_FILE=/etc/hrms-backup/age-recipients.txt
RCLONE_REMOTE=hrms-gdrive:HRMS-Backups
MINIO_VOLUME=hrms-prod_minio_data
ENV_FILES="/opt/hrms/.env /opt/hrms/apps/api/env/.env.production"
# Optional dead-man switch, e.g. https://hc-ping.com/<uuid> (pinged on success, <url>/fail on failure).
HEALTHCHECK_URL=

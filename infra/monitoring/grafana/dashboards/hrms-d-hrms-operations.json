      "targets": [
        {
          "expr": "sum by (event) (increase(hrms_security_events_total{event=~\"login.failed|platform.login.failed|account.locked|rate_limited\"}[1h]))",
          "legendFormat": "{{event}}",
          "refId": "A"
        }

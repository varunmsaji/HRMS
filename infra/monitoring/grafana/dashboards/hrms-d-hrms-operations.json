        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (operation, outcome) (increase(hrms_operations_total{operation=~\"leave\\\\.(accrual|comp_off|year_end)\\\\..*\"}[24h]))",
          "legendFormat": "{{operation}} {{outcome}}",
          "refId": "A"
        }
      ],
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Payroll operations",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (operation, outcome) (increase(hrms_operations_total{operation=~\"payroll\\\\..*\"}[24h]))",
          "legendFormat": "{{operation}} {{outcome}}",
          "refId": "A"
        }
      ],
      "id": 6,
      "gridPos": {
        "x": 12,

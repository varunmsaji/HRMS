{
  "title": "HRMS - D. HRMS operations",
  "uid": "hrms-d-hrms-operations",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus"
      }
    ]
  },
  "panels": [
    {
      "title": "Attendance operations",
      "type": "timeseries",
      "description": "rejected = policy outcome (expected); failed = server-side.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (operation, outcome) (increase(hrms_operations_total{operation=~\"attendance\\\\..*\"}[1h]))",
          "legendFormat": "{{operation}} {{outcome}}",
          "refId": "A"
        }
      ],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Attendance server-side failures",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(hrms_operations_total{operation=~\"attendance\\\\..*\",outcome=\"failed\"}[15m]))",
          "legendFormat": "failed",
          "refId": "A"
        }
      ],
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Punch latency p95",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(hrms_operation_duration_seconds_bucket{operation=~\"attendance\\\\.(punch|face)\\\\..*\"}[15m])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Leave operations",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (operation, outcome) (increase(hrms_operations_total{operation=~\"leave\\\\..*\"}[1h]))",
          "legendFormat": "{{operation}} {{outcome}}",
          "refId": "A"
        }
      ],
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Leave accrual/expiry runs",
      "type": "timeseries",

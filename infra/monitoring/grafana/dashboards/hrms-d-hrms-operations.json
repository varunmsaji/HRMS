        "defaults": {
          "unit": "short",
          "noValue": "0"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (dependency, category) (increase(hrms_dependency_errors_total[1h]))",
          "legendFormat": "{{dependency}}/{{category}}",
          "refId": "A"
        }
      ],
      "id": 10,
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Login failures / lockouts",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0"
        },
        "overrides": []

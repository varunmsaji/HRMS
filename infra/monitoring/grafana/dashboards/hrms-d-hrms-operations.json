      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(hrms_operation_duration_seconds_bucket{operation=\"payroll.pay_run.compute\"}[24h])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Committed audited transitions",
      "type": "timeseries",

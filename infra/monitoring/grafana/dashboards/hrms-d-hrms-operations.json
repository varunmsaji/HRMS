      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (state) (increase(hrms_celery_tasks_finished_total{task=~\"employee_import\\\\..*\"}[24h]))",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ],
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 32,
